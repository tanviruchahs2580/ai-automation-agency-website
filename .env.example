# Canonical origin used for metadata, canonical URLs, sitemap.xml and robots.txt.
# Set this to the production origin before launch, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://vantiqsystems.com
NEXT_PUBLIC_SITE_URL=

# Public contact overrides (build-time inlined). Unset = placeholder fallbacks
# in src/data/site.ts remain visible.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_MEETING_LINK=

# Optional intake email delivery (see src/lib/brief-notification.ts).
# Set BOTH to activate: every accepted brief is emailed to the inbox below.
# Without them the API receipts only — behaviour is unchanged.
RESEND_API_KEY=
BRIEF_NOTIFICATION_EMAIL=
# Optional verified sender identity (Resend domain required):
BRIEF_NOTIFICATION_FROM=

# Intake endpoint (/api/project-brief) rate limits per client IP taken from
# x-forwarded-for. Deploy behind a proxy/platform that overwrites this header
# (Vercel, Nginx, Cloudflare) so clients cannot spoof it.
