# Canonical origin used for metadata, canonical URLs, sitemap.xml and robots.txt.
# Set this to the production origin before launch, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://vantiqsystems.com
NEXT_PUBLIC_SITE_URL=

# Intake endpoint (/api/project-brief) rate limits per client IP taken from
# x-forwarded-for. Deploy behind a proxy/platform that overwrites this header
# (Vercel, Nginx, Cloudflare) so clients cannot spoof it.
