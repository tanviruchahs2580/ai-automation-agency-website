{
  "name": "ai-automation-agency-website",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise AI engineering & automation company website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:budget": "node scripts/check-budget.mjs",
    "check:rendered": "node scripts/check-rendered-html.mjs",
    "check:deps": "npm audit --omit=dev --audit-level=high",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:journey": "node scripts/user-journey.mjs",
    "check:vitals": "node scripts/measure-vitals.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:rendered && npm run check:budget"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "next": "^16.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
